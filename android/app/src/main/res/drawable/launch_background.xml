<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the first stop of the Flutter splash gradient (AppColors.primary)
     so the native launch window and the Dart splash read as one screen
     instead of a white flash followed by orange. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
</layer-list>
