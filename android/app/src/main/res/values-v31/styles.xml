<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ replaces the old windowBackground splash with the system
     SplashScreen API. Without these, the system draws the launcher icon on a
     white window and the Dart splash then cuts to orange, which reads as two
     separate splash screens. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
